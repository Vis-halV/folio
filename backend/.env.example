# Flask
FLASK_ENV=development
FLASK_APP=wsgi.py
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

# Database (Heroku hands out postgres:// URLs; the app normalizes them)
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio

# CORS origin of the React dev server (not needed for the single-dyno deploy)
FRONTEND_ORIGIN=http://localhost:3000

# Bootstrap admin account, consumed by `flask create-admin`
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-password

# Local uploads (used when the S3 vars below are unset)
# Relative paths resolve against backend/, not the process working directory.
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10

# Optional S3-compatible object storage for photos and resumes
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_ENDPOINT_URL=
