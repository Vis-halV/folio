# Root reference of every variable the deployment needs.
# Locally, use backend/.env and frontend/.env (see the *.env.example next to them).
# On Heroku, set these with `heroku config:set`.

FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12

DATABASE_URL=postgresql://user:password@host:5432/portfolio
FRONTEND_ORIGIN=https://your-app.herokuapp.com

ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=replace-with-a-strong-password

UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH_MB=10

# Optional object storage (required on Heroku: the dyno filesystem is ephemeral)
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_ENDPOINT_URL=

# Frontend build-time variable; leave empty for the single-deployment setup
REACT_APP_API_BASE_URL=
